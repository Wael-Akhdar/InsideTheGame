# Microsoft Foundry / Azure OpenAI (optional: without it GamePulse uses offline templates)
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-5.4-mini
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# or GitHub Models (free tier, OpenAI models served from Azure): a GitHub token with the "Models: read" permission
# GITHUB_MODELS_TOKEN=
# GITHUB_MODEL=openai/gpt-4.1-mini
